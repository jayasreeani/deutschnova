// Production PostgreSQL Schema for DeutschCareer AI (Supabase / Neon / AWS RDS)

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  LEARNER
  ADMIN
}

enum GermanLevel {
  BEGINNER        // A1
  ELEMENTARY      // A2
  INTERMEDIATE    // B1
  UPPER_INTER     // B2
  ADVANCED        // C1
}

enum VocabCategory {
  BASICS
  TRAVEL
  BUSINESS
  TECHNOLOGY
  PROJECT_MANAGEMENT
  IT_INDUSTRY
}

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  passwordHash  String
  role          String         @default("LEARNER")
  avatarUrl     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  profile          UserProfile?
  learningGoals    LearningGoal[]
  quizResults      QuizResult[]
  progress         Progress?
  userAchievements UserAchievement[]
  activities       UserActivity[]
  savedVocabulary  UserSavedVocabulary[]
  chatSessions     ChatSession[]
}

model UserProfile {
  id              String      @id @default(uuid())
  userId          String      @unique
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  country         String?
  nativeLanguage  String?
  learningGoal    String?
  currentLevel    String      @default("BEGINNER")
  dailyMinutes    Int         @default(15)
  onboardingDone  Boolean     @default(false)
  careerField     String?
  targetExam      String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model LearningGoal {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  category      String
  targetLevel   String
  targetDate    DateTime?
  completed     Boolean     @default(false)
  createdAt     DateTime    @default(now())
}

model Lesson {
  id                    String      @id @default(uuid())
  title                 String
  subtitle              String?
  description           String
  level                 String      @default("BEGINNER")
  category              String      @default("Career & IT")
  orderIndex            Int         @default(1)
  estimatedMinutes      Int         @default(15)
  vocabularyJson        Json
  grammarJson           Json
  examplesJson          Json
  practiceQuestionsJson Json
  summaryJson           Json
  isPublished           Boolean     @default(true)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
}

model Vocabulary {
  id                 String                @id @default(uuid())
  word               String
  article            String?
  plural             String?
  englishMeaning     String
  pronunciationTips  String?
  usageExampleDe     String
  usageExampleEn     String
  category           String                @default("BASICS")
  level              String                @default("BEGINNER")
  partOfSpeech       String?
  createdAt          DateTime              @default(now())
  savedByUsers       UserSavedVocabulary[]
}

model UserSavedVocabulary {
  id            String      @id @default(uuid())
  userId        String
  vocabularyId  String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabulary    Vocabulary  @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)
  isFavorite    Boolean     @default(false)
  masteryLevel  Int         @default(0)
  lastReviewed  DateTime?
  nextReviewAt  DateTime?
  createdAt     DateTime    @default(now())

  @@unique([userId, vocabularyId])
}

model Quiz {
  id            String       @id @default(uuid())
  title         String
  description   String?
  category      String       @default("General")
  level         String       @default("BEGINNER")
  questionsJson Json
  lessonId      String?
  createdAt     DateTime     @default(now())
  results       QuizResult[]
}

model QuizResult {
  id              String      @id @default(uuid())
  userId          String
  quizId          String?
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz            Quiz?       @relation(fields: [quizId], references: [id], onDelete: SetNull)
  score           Int
  totalQuestions  Int
  percentage      Float
  category        String      @default("General")
  answersJson     Json
  completedAt     DateTime    @default(now())
}

model Progress {
  id                    String      @id @default(uuid())
  userId                String      @unique
  user                  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  wordsLearned          Int         @default(0)
  lessonsCompleted      Int         @default(0)
  streakDays            Int         @default(1)
  lastActiveDate        DateTime    @default(now())
  totalTimeMinutes      Int         @default(0)
  quizAverageScore      Float       @default(0.0)
  readingScore          Int         @default(20)
  writingScore          Int         @default(20)
  listeningScore        Int         @default(20)
  grammarScore          Int         @default(20)
  vocabularyScore       Int         @default(20)
  completedLessonsJson  Json        @default("[]")
  updatedAt             DateTime    @updatedAt
}

model Achievement {
  id               String            @id @default(uuid())
  code             String            @unique
  title            String
  description      String
  icon             String
  badgeCategory    String            @default("GENERAL")
  criteria         String
  requiredCount    Int               @default(1)
  users            UserAchievement[]
}

model UserAchievement {
  id             String      @id @default(uuid())
  userId         String
  achievementId  String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement    Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  unlockedAt     DateTime    @default(now())

  @@unique([userId, achievementId])
}

model UserActivity {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityType  String
  title         String
  description   String
  metadataJson  Json?
  createdAt     DateTime    @default(now())
}

model ChatSession {
  id            String        @id @default(uuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenario      String        @default("free_tutor")
  title         String        @default("Conversation with KI-Tutor")
  messagesJson  Json
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}
